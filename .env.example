# Copy this file to .env and fill in your real values.
# Get sandbox credentials free at https://account.africastalking.com

# Sandbox username is always literally "sandbox" (not your real username)
AT_USERNAME=sandbox

# Your sandbox API key, from the "Settings > API Key" page in the AT dashboard
AT_API_KEY=your_sandbox_api_key_here

# Optional: only relevant for production/live accounts with an approved Sender ID
AT_SENDER_ID=

# The number shown/texted to users for the Legal Aid Hotline option
LEGAL_AID_HOTLINE=0800 720 000

# Secret used to one-way-hash phone numbers before storing them against a
# case report. Change this to a long random string in production and never
# commit the real value to git.
PHONE_HASH_SALT=change-me-in-production

# On Render, set this to the path on your attached persistent disk.
# Example: /var/data/sms_logs.db
SMS_DB_PATH=sms_logs.db
